{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marktdaten-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Diese Pfade beantwortet der Worker selbst, alles andere sind statische Dateien aus dist/.
    "run_worker_first": ["/data/*", "/api/*", "/app-config.json"]
  },
  // Datenspeicher der Produktivversion („marktdaten-dashboard-data“).
  // Die ID muss fest eingetragen sein, sonst schlagen Vorschau-Builds fehl (Fehler 10021).
  "kv_namespaces": [{ "binding": "DATA", "id": "b4868eb9bffb4393b5fc9c341b3d6c81" }],
  // Vorschau-Versionen für Pull Requests nutzen einen eigenen Speicher („marktdaten-dashboard-preview“),
  // damit sie die echten Daten nicht verändern. Vorschauen haben keine Cron-Läufe: Daten per „Jetzt abrufen“ laden.
  "previews": {
    "kv_namespaces": [{ "binding": "DATA", "id": "2f677c03001946548d54afb46301204b" }]
  },
  "triggers": {
    // Ein Ausdruck, fünf Läufe pro Stunde (Minute 5–9); die Minute wählt den Teilbereich, siehe MINUTE_PART in worker/index.js.
    "crons": ["5-9 * * * *"]
  }
}
