{
  "api": {
    "baseUrl": "https://api.bigdata.com",
    "apiKeyHeader": "X-API-KEY",
    "apiKeyPrefix": "",
    "timeoutMs": 30000
  },
  "output": "public/data/marketdata.json",
  "instruments": [
    {
      "id": "beispiel",
      "name": "Beispiel-Unternehmen",
      "ticker": "TICKER",
      "currency": "USD",
      "requests": {
        "prices": {
          "method": "GET",
          "path": "/PFAD/ZUM/KURS-ENDPUNKT",
          "query": { "entity_id": "RP_ENTITY_ID" }
        },
        "tearsheet": {
          "method": "GET",
          "path": "/PFAD/ZUM/KENNZAHLEN-ENDPUNKT",
          "query": { "entity_id": "RP_ENTITY_ID" }
        }
      },
      "price": {
        "last": "prices.data.last",
        "change": "prices.data.change",
        "changePct": "prices.data.change_pct",
        "asOf": "prices.data.timestamp"
      },
      "series": { "path": "prices.data.history", "t": "date", "v": "close", "last": 120 },
      "measures": [
        { "key": "pe", "label": "KGV", "path": "tearsheet.data.pe_ratio", "decimals": 1 },
        {
          "key": "sentiment",
          "label": "Sentiment",
          "path": "tearsheet.data.sentiment.current",
          "previousPath": "tearsheet.data.sentiment.previous",
          "decimals": 2,
          "series": { "path": "tearsheet.data.sentiment.history", "t": "date", "v": "value" }
        }
      ]
    }
  ]
}
